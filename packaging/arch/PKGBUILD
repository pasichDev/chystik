# The tag archive is pinned so this file can be copied to the AUR unchanged.
pkgname=chystik
pkgver=0.2.1
pkgrel=1
pkgdesc='Safety-first developer disk cleanup GUI and CLI'
arch=('x86_64')
url='https://github.com/pasichDev/chystik'
license=('MIT')
depends=('gtk3' 'libxkbcommon' 'libxkbcommon-x11' 'libx11' 'mesa')
makedepends=('cargo' 'pkgconf' 'gtk3')
source=("https://github.com/pasichDev/chystik/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('9d0ba9c890f03c56b164b7e37cf0960b068d9b6cf38c40ce61936945c18d15e9')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    cargo build --release --locked --package chystik-gui --package chystik-cli
}

package() {
    local icon size
    cd "${srcdir}/${pkgname}-${pkgver}"

    install -Dm755 target/release/chystik-gui "${pkgdir}/usr/bin/chystik-gui"
    install -Dm755 target/release/chystik "${pkgdir}/usr/bin/chystik"
    install -Dm644 "$(find target/release/build -path '*/out/chystik.1' -type f -print -quit)" \
        "${pkgdir}/usr/share/man/man1/chystik.1"
    install -Dm644 packaging/chystik.desktop "${pkgdir}/usr/share/applications/chystik.desktop"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    for icon in assets/icons/chystik-*.png; do
        size="${icon##*-}"
        size="${size%.png}"
        install -Dm644 "$icon" "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/chystik.png"
    done
    install -Dm644 assets/icon.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/chystik.svg"
}
