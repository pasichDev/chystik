Name:           chystik
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Safety-first developer disk cleanup GUI and CLI
License:        MIT
URL:            https://github.com/pasichDev/chystik
Source0:        chystik-@VERSION@.tar.gz
BuildArch:      x86_64
# The release pipeline repackages a stripped Cargo binary.  There is no source
# tree or debug data left for RPM's automatic debug packages to consume.
%global debug_package %{nil}
Requires:       gtk3
Requires:       libxkbcommon
Requires:       libxkbcommon-x11
Requires:       mesa-libGL
Requires:       libX11
Requires:       libxcb

%description
Chystik classifies developer caches and only moves verified cleanup targets to trash.

%prep
%setup -q

%build

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}
cp -a . %{buildroot}/

%files
%license /usr/share/licenses/chystik/LICENSE
/usr/bin/chystik-gui
/usr/bin/chystik
/usr/share/man/man1/chystik.1*
/usr/share/bash-completion/completions/chystik
/usr/share/zsh/site-functions/_chystik
/usr/share/fish/vendor_completions.d/chystik.fish
/usr/share/powershell/Modules/Chystik/chystik.ps1
/usr/share/applications/chystik.desktop
/usr/share/icons/hicolor/*/apps/chystik.png
/usr/share/icons/hicolor/scalable/apps/chystik.svg

%changelog
* Tue Aug 25 2026 pasichDev <67899666+pasichDev@users.noreply.github.com> - @VERSION@-1
- Initial Linux package
